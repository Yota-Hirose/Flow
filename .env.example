# 同期(T-20 / T-21)を有効にするための設定。
# **この2つが無くてもアプリは動く。** 同期メニューが出なくなるだけで、
# 学習はローカルだけで完結する(SPEC 原則6: ローカルファースト)。
#
# 取得場所: Supabaseダッシュボードの右上 **Connect** ボタン → App Frameworks
#           (URLと鍵が両方ここに出る。個別ページを探すより速い)
#
# 鍵は「ブラウザに配られる前提」の公開鍵で、公開されて構わない。実際の
# アクセス制御は行レベルセキュリティ(supabase/schema.sql)が担う。
# **secret / service_role キーは絶対にここへ書かない。**

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 新しい publishable キー(sb_publishable_... )を推奨。
# Supabaseは2026年末に anon キーを廃止する。
VITE_SUPABASE_PUBLISHABLE_KEY=

# 旧 anon キーしか無い場合はこちらでもよい(publishable が優先される)
# VITE_SUPABASE_ANON_KEY=
